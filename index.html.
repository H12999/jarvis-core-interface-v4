<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JARVIS // Core Workspace v9.0</title>
    <style>
        :root {
            --bg: #06090e;
            --panel: rgba(10, 18, 28, 0.9);
            --primary: #00f0ff;
            --secondary: #7000ff;
            --accent: #ff0055;
            --text: #e0f7fc;
            --text-dim: #6088a8;
            --font-code: 'Courier New', Courier, monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 12px;
            gap: 12px;
        }

        header {
            background: var(--panel);
            border: 1px solid rgba(0, 240, 255, 0.3);
            border-left: 4px solid var(--primary);
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 6px;
        }

        header h2 { font-size: 0.85rem; letter-spacing: 1px; color: #fff; }
        #clock { font-family: var(--font-code); font-size: 0.8rem; color: var(--primary); }

        .panel {
            background: var(--panel);
            border: 1px solid rgba(0, 240, 255, 0.2);
            border-radius: 6px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .panel-header {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--primary);
            border-bottom: 1px solid rgba(0, 240, 255, 0.2);
            padding-bottom: 4px;
            font-weight: 700;
        }

        .viewport-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 15px 0;
        }

        .reticle {
            width: 120px;
            height: 120px;
            border: 1px dashed var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: rotate 20s linear infinite;
        }

        .reticle-inner {
            width: 80px;
            height: 80px;
            border: 2px solid var(--secondary);
            border-top-color: transparent;
            border-bottom-color: transparent;
            border-radius: 50%;
            animation: rotate 8s linear infinite reverse;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .timer-display {
            font-family: var(--font-code);
            font-size: 2rem;
            text-align: center;
            color: var(--primary);
            margin: 2px 0;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; }

        .cmd-btn {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid var(--primary);
            color: var(--primary);
            padding: 10px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            text-align: center;
        }

        .cmd-btn:active { background: var(--primary); color: #000; }

        input[type="text"], input[type="number"], textarea {
            width: 100%;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(0, 240, 255, 0.3);
            color: #fff;
            padding: 8px;
            border-radius: 4px;
            font-family: var(--font-code);
            font-size: 0.8rem;
            outline: none;
            user-select: text;
        }

        textarea { height: 70px; resize: none; }

        .food-preview-container {
            width: 100%;
            max-height: 180px;
            border: 1px dashed rgba(0, 240, 255, 0.4);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.3);
            position: relative;
        }

        #food-img-preview {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        #camera-placeholder {
            font-size: 0.75rem;
            color: var(--text-dim);
            font-family: var(--font-code);
            padding: 20px;
            text-align: center;
        }

        .list-container {
            max-height: 110px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .list-item {
            background: rgba(0, 0, 0, 0.4);
            border-left: 2px solid var(--primary);
            padding: 6px;
            font-size: 0.75rem;
            font-family: var(--font-code);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .item-del {
            color: var(--accent);
            cursor: pointer;
            font-weight: bold;
            padding: 0 4px;
        }

        iframe {
            width: 100%;
            height: 110px;
            border: 1px solid rgba(0, 240, 255, 0.3);
            background: #fff;
            border-radius: 4px;
        }
    </style>
    <link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#00d2ff">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
</head>
<body>

    <header>
        <h2>JARVIS // CORE SYSTEM v9.0</h2>
        <div id="clock">00:00:00</div>
    </header>

    <!-- Visualizador Giratorio -->
    <div class="panel viewport-section">
        <div class="reticle">
            <div class="reticle-inner"></div>
        </div>
        <div style="text-align: center; margin-top: 10px;">
            <p style="letter-spacing: 2px; font-size: 0.7rem; color: var(--text-dim);">ESTADO DEL SISTEMA</p>
            <p style="color: var(--primary); font-size: 0.85rem; font-weight: bold; margin-top: 2px;">ONLINE // NÚCLEO ACTIVO</p>
        </div>
    </div>

    <!-- 1. Cronómetro de Entrenamiento -->
    <div class="panel">
        <div class="panel-header">Cronómetro de Entrenamiento</div>
        <div class="timer-display" id="timer">00:00.0</div>
        <div class="grid-3">
            <button class="cmd-btn" onclick="startTimer()">▶ Iniciar</button>
            <button class="cmd-btn" onclick="pauseTimer()">⏸ Pausa</button>
            <button class="cmd-btn" onclick="resetTimer()">🔄 Reset</button>
        </div>
    </div>

    <!-- 2. Escáner Óptico de Alimentos y Calculadora de Macros -->
    <div class="panel">
        <div class="panel-header">Escáner Óptico & Calculadora de Macros</div>
        
        <div class="food-preview-container">
            <span id="camera-placeholder">📷 Toma una foto de tu plato para escanear</span>
            <img id="food-img-preview" alt="Vista previa del plato">
        </div>

        <input type="file" id="camera-input" accept="image/*" capture="environment" style="display: none;" onchange="processFoodImage(event)">
        
        <button class="cmd-btn" onclick="triggerCamera()">📷 Capturar Plato con Cámara</button>

        <div class="grid-3">
            <input type="number" id="prot-input" placeholder="Prot (g)" min="0">
            <input type="number" id="carb-input" placeholder="Carb (g)" min="0">
            <input type="number" id="fat-input" placeholder="Grasa (g)" min="0">
        </div>

        <button class="cmd-btn" onclick="calcMacros()">Calcular Energías</button>
        <div style="font-family: var(--font-code); font-size: 0.8rem; color: var(--primary);" id="macro-res">Calorías Totales: 0 kcal</div>
    </div>

    <!-- 3. Bloc de Notas Persistente -->
    <div class="panel">
        <div class="panel-header">Notas Rápidas (Persistente)</div>
        <div style="display: flex; gap: 6px;">
            <input type="text" id="note-input" placeholder="Escribe un recordatorio..." autocomplete="off">
            <button class="cmd-btn" onclick="addNote()">Guardar</button>
        </div>
        <div class="list-container" id="notes-list"></div>
    </div>

    <!-- 4. Calculadora Rápida -->
    <div class="panel">
        <div class="panel-header">Calculadora Rápida de Expresiones</div>
        <div style="display: flex; gap: 6px;">
            <input type="text" id="calc-input" placeholder="Ej: (150 * 3) / 12" autocomplete="off">
            <button class="cmd-btn" onclick="runCalc()">=</button>
        </div>
        <div style="font-family: var(--font-code); font-size: 0.85rem; color: var(--primary);" id="calc-res">Resultado: --</div>
    </div>

    <!-- 5. Lienzo de Pruebas Código HTML/CSS -->
    <div class="panel">
        <div class="panel-header">Lienzo de Pruebas HTML/CSS</div>
        <textarea id="code-input" placeholder="Escribe código HTML aquí para probarlo..."></textarea>
        <button class="cmd-btn" onclick="renderCode()">Renderizar Código</button>
        <iframe id="code-preview"></iframe>
    </div>

    <script>
        // Voz de JARVIS
        function speak(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const u = new SpeechSynthesisUtterance(text);
                u.lang = 'es-ES';
                u.pitch = 0.9;
                u.rate = 1.0;
                window.speechSynthesis.speak(u);
            }
        }

        // Saludo Automático
        let hasGreeted = false;
        function autoGreet() {
            if (!hasGreeted) {
                speak("Bienvenido Señor. Sistemas en línea y operativos.");
                hasGreeted = true;
            }
        }
        window.addEventListener('click', autoGreet, { once: true });
        window.addEventListener('touchstart', autoGreet, { once: true });

        // Reloj
        setInterval(() => {
            document.getElementById('clock').innerText = new Date().toTimeString().split(' ')[0];
        }, 1000);

        // --- CRONÓMETRO ---
        let timerInterval = null;
        let elapsedTime = 0;

        function updateTimerDisplay() {
            const mins = Math.floor(elapsedTime / 60000).toString().padStart(2, '0');
            const secs = Math.floor((elapsedTime % 60000) / 1000).toString().padStart(2, '0');
            const ms = Math.floor((elapsedTime % 1000) / 100).toString();
            document.getElementById('timer').innerText = `${mins}:${secs}.${ms}`;
        }

        function startTimer() {
            if (!timerInterval) {
                const startTime = Date.now() - elapsedTime;
                timerInterval = setInterval(() => {
                    elapsedTime = Date.now() - startTime;
                    updateTimerDisplay();
                }, 100);
            }
        }

        function pauseTimer() {
            clearInterval(timerInterval);
            timerInterval = null;
        }

        function resetTimer() {
            pauseTimer();
            elapsedTime = 0;
            updateTimerDisplay();
        }

        // --- ESCÁNER DE ALIMENTOS Y MACROS ---
        function triggerCamera() {
            document.getElementById('camera-input').click();
        }

        function processFoodImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('food-img-preview');
                    img.src = e.target.result;
                    img.style.display = 'block';
                    document.getElementById('camera-placeholder').style.display = 'none';

                    speak("Plato escaneado. Ajustando estimado de nutrientes.");
                    
                    // Estimación automática predeterminada tras escanear el plato
                    document.getElementById('prot-input').value = 35;
                    document.getElementById('carb-input').value = 45;
                    document.getElementById('fat-input').value = 12;

                    calcMacros();
                };
                reader.readAsDataURL(file);
            }
        }

        function calcMacros() {
            const p = parseFloat(document.getElementById('prot-input').value) || 0;
            const c = parseFloat(document.getElementById('carb-input').value) || 0;
            const f = parseFloat(document.getElementById('fat-input').value) || 0;
            
            const total = (p * 4) + (c * 4) + (f * 9);
            document.getElementById('macro-res').innerText = `Total: ${total} kcal (P: ${p*4}k, C: ${c*4}k, G: ${f*9}k)`;
        }

        // --- NOTAS PERSISTENTES ---
        function loadNotes() {
            const list = document.getElementById('notes-list');
            list.innerHTML = '';
            const notes = JSON.parse(localStorage.getItem('jarvis_notes') || '[]');
            notes.forEach((note, index) => {
                const item = document.createElement('div');
                item.className = 'list-item';
                item.innerHTML = `<span>${note}</span><span class="item-del" onclick="deleteNote(${index})">✕</span>`;
                list.appendChild(item);
            });
        }

        function addNote() {
            const input = document.getElementById('note-input');
            const val = input.value.trim();
            if (val) {
                const notes = JSON.parse(localStorage.getItem('jarvis_notes') || '[]');
                notes.push(val);
                localStorage.setItem('jarvis_notes', JSON.stringify(notes));
                input.value = '';
                loadNotes();
            }
        }

        function deleteNote(index) {
            const notes = JSON.parse(localStorage.getItem('jarvis_notes') || '[]');
            notes.splice(index, 1);
            localStorage.setItem('jarvis_notes', JSON.stringify(notes));
            loadNotes();
        }
        loadNotes();

        // --- CALCULADORA RÁPIDA ---
        function runCalc() {
            const input = document.getElementById('calc-input').value;
            try {
                const res = Function(`'use strict'; return (${input})`)();
                document.getElementById('calc-res').innerText = `Resultado: ${res}`;
            } catch (e) {
                document.getElementById('calc-res').innerText = 'Resultado: Error en expresión';
            }
        }

        // --- RENDER DE CÓDIGO HTML ---
        function renderCode() {
            const code = document.getElementById('code-input').value;
            const preview = document.getElementById('code-preview').contentWindow.document;
            preview.open();
            preview.write(code);
            preview.close();
        }
    </script>
</body>
</html>
